# ============================================================
# VARIÁVEIS DE AMBIENTE — copie este arquivo para ".env.local"
# e preencha os valores. Na Vercel, cadastre em:
# Settings → Environment Variables
# ============================================================

# Senha para acessar a página /admin (consulta de leads).
# Escolha uma senha forte e não compartilhe.
ADMIN_PASSWORD=troque-esta-senha

# ---------- Supabase (banco de leads) ----------
# Endereço e chave PÚBLICA do projeto (Supabase → Settings → API).
# Podem aparecer no site — a segurança fica no banco (RLS).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Chave SECRETA (service_role) — usada pelo painel /admin e, obrigatoriamente,
# pela Área do Criador. Supabase → Settings → API → service_role.
# NUNCA com prefixo NEXT_PUBLIC_. Ela ignora as regras de segurança do banco.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# ÁREA DO CRIADOR (/criador)
# A área é protegida pela mesma ADMIN_PASSWORD lá de cima — não há
# segunda senha. Nenhuma das chaves abaixo pode ter prefixo NEXT_PUBLIC_:
# todas são lidas só no servidor e nunca chegam ao navegador.
# ============================================================

# Mesmo endereço do NEXT_PUBLIC_SUPABASE_URL acima. Só precisa preencher
# se você preferir manter o nome sem prefixo; o código aceita os dois.
SUPABASE_URL=

# ---------- Geração de texto (Claude) ----------
# console.anthropic.com → API Keys. Usada pelo n8n para escrever a pauta.
ANTHROPIC_API_KEY=

# ---------- Bancos de foto real ----------
# Fonte primária: pexels.com/api. Segunda fonte: unsplash.com/developers.
# Só entram fotos reais destes dois. Nunca imagem gerada por IA.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# ---------- Coleta de referências do Instagram ----------
# console.apify.com → Settings → Integrations. Actor apify/instagram-scraper.
APIFY_TOKEN=

# ---------- Publicação no Instagram ----------
# ID da conta profissional e token de acesso de longa duração,
# do app do Facebook ligado à página. developers.facebook.com
IG_USER_ID=
IG_ACCESS_TOKEN=
