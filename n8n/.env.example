# ============================================================
# n8n self-hospedado — copie para ".env" no MESMO diretório do
# docker-compose.yml e preencha. O arquivo .env NÃO vai para o git.
# ============================================================
# O compose falha de propósito se um valor obrigatório estiver vazio,
# em vez de subir pela metade e falhar depois em silêncio.
# ============================================================

# ---------- Domínio ----------
# Precisa apontar para o IP deste servidor ANTES da primeira subida,
# senão o Let's Encrypt não consegue emitir o certificado.
N8N_HOST=n8n.wmassessoria.com.br

# E-mail para os avisos de expiração do certificado.
ACME_EMAIL=voce@wmassessoria.com.br

# ---------- Banco de estado do n8n ----------
# Guarda workflows, credenciais e histórico de execuções.
# Gere com: openssl rand -base64 24
POSTGRES_PASSWORD=

# ---------- Chave de criptografia ----------
# Criptografa TODAS as credenciais salvas no n8n (Gmail, Z-API, Supabase,
# Anthropic). Gere UMA vez com:  openssl rand -hex 32
#
# Guarde uma cópia FORA do servidor. Se este valor mudar ou se perder, as
# credenciais salvas viram bytes ilegíveis e têm de ser recadastradas uma
# por uma — inclusive o OAuth do Gmail.
N8N_ENCRYPTION_KEY=

# ---------- Z-API ----------
# Substituem as Variables ($vars) da edição Cloud. Sem elas, a URL de
# envio sai inválida e as mensagens falham sem erro visível.
# Z-API → sua instância → "ID da instância" e "Token".
ZAPI_INSTANCE=
ZAPI_TOKEN=

# O Client-Token NÃO vai aqui: é a credencial "Header Auth" do n8n
# (nome do header: Client-Token). Veja o README.

# ---------- Destino do handoff ----------
# Quem recebe o resumo quando a Ana qualifica um lead. Só dígitos, com
# 55 na frente. CANAL_NOTIFICACAO tem precedência sobre NUMERO_2.
CANAL_NOTIFICACAO=
NUMERO_2=
