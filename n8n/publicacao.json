    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/publicacoes",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "=eq.{{ $('Carrossel completo?').item.json.publicacao_id }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Prefer", "value": "return=minimal" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'publicada', ig_media_id: String($json.id), publicada_em: new Date().toISOString(), erro_detalhe: null }) }}",
        "options": {}
      },
      "id": "pub-marcar",
      "name": "Supabase: marcar publicada",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 120]
    },
    {
      "parameters": {
        "jsCode": "// Junta tudo que deu errado, venha de onde vier, num formato só.\n// O motivo fica visível no calendário da Área do Criador.\nfunction motivo(j) {\n  if (j && j.erro) return String(j.erro);\n  if (j && j.error) {\n    if (typeof j.error === 'string') return j.error;\n    const e = j.error.error || j.error;\n    return String(e.message || JSON.stringify(e)).slice(0, 900);\n  }\n  return 'Falha sem detalhe do Instagram.';\n}\n\nfunction idDaPublicacao(item) {\n  const j = item.json || {};\n  if (j.publicacao_id) return j.publicacao_id;\n  // Nó de erro do n8n guarda o item que entrou.\n  const origem = (item.pairedItem && item.json && item.json.publicacao_id) || null;\n  return origem;\n}\n\nreturn items\n  .map((item) => ({\n    json: {\n      publicacao_id: idDaPublicacao(item),\n      erro_detalhe: motivo(item.json),\n    },\n  }))\n  .filter((i) => i.json.publicacao_id);"
      },
      "id": "pub-erro-montar",
      "name": "Montar erro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 460]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/publicacoes",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [{ "name": "id", "value": "=eq.{{ $json.publicacao_id }}" }]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Prefer", "value": "return=minimal" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'erro', erro_detalhe: $json.erro_detalhe }) }}",
        "options": {}
      },
      "id": "pub-marcar-erro",
      "name": "Supabase: marcar erro",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 460],
      "notes": "Status erro com o motivo preenchido, e o fluxo para. Sem retry infinito: na próxima hora ela não é mais pega, porque não está mais agendada."
    }
