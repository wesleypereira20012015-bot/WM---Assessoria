    {
      "parameters": {
        "url": "={{ $json.supabase_url }}/rest/v1/publicacoes",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "select", "value": "id,legenda,hashtags,assets(ordem,url_publica)" },
            { "name": "status", "value": "eq.agendada" },
            { "name": "agendada_para", "value": "=lte.{{ new Date().toISOString() }}" },
            { "name": "order", "value": "agendada_para.asc" },
            { "name": "limit", "value": "5" }
          ]
        },
        "options": {}
      },
      "id": "pub-buscar",
      "name": "Supabase: agendadas que já venceram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-880, 300],
      "executeOnce": true,
      "alwaysOutputData": true,
      "notes": "Só status agendada. Como o banco recusa agendada sem aprovada_em, nada chega aqui sem aprovação humana registrada."
    },
    {
      "parameters": {
        "jsCode": "// Uma linha por prancha, na ordem, para criar os containers filhos.\n// Publicação sem arte nenhuma nunca deve chegar aqui; se chegar, é erro\n// e vai para a trilha de erro em vez de virar um post quebrado.\nconst saida = [];\n\nfor (const item of items) {\n  const lista = Array.isArray(item.json) ? item.json : [item.json];\n  for (const p of lista) {\n    if (!p || !p.id) continue;\n    const assets = (p.assets || []).slice().sort((a, b) => a.ordem - b.ordem);\n    const legenda = [p.legenda || '', (p.hashtags || []).join(' ')]\n      .filter(Boolean)\n      .join('\\n\\n')\n      .slice(0, 2200);\n\n    if (assets.length < 2 || assets.length > 10) {\n      saida.push({\n        json: {\n          falha: true,\n          publicacao_id: p.id,\n          erro: 'Carrossel com ' + assets.length + ' imagens; o Instagram aceita de 2 a 10.',\n        },\n      });\n      continue;\n    }\n\n    for (const a of assets) {\n      saida.push({\n        json: {\n          falha: false,\n          publicacao_id: p.id,\n          ordem: a.ordem,\n          total: assets.length,\n          url_publica: a.url_publica,\n          legenda,\n        },\n      });\n    }\n  }\n}\n\nreturn saida;"
      },
      "id": "pub-explodir",
      "name": "Uma linha por prancha",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-660, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "ok",
              "leftValue": "={{ $json.falha }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "pub-se-valida",
      "name": "Prancha utilizável?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $('Config').first().json.graph_version }}/{{ $('Config').first().json.ig_user_id }}/media",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "is_carousel_item", "value": "true" },
            { "name": "image_url", "value": "={{ $json.url_publica }}" }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "pub-filho",
      "name": "Instagram: container da imagem",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-220, 200],
      "retryOnFail": false,
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "instagram-bearer",
          "name": "Instagram Bearer"
        }
      },
      "notes": "O Instagram baixa a imagem da URL pública do Storage. Credencial Header Auth: Authorization = 'Bearer SEU_IG_ACCESS_TOKEN'. Sem retry: falha vira status erro, não fica tentando para sempre."
    },
    {
      "parameters": {
        "jsCode": "// Junta os filhos por publicação, na ordem, e monta o container do\n// carrossel. Publicação que perdeu qualquer filho vira erro: melhor não\n// publicar do que publicar um carrossel faltando prancha.\nconst entradas = $('Uma linha por prancha').all()\n  .map((i) => i.json)\n  .filter((j) => !j.falha);\n\nconst criados = items.map((i) => i.json);\n\nconst porPublicacao = {};\nentradas.forEach((entrada, indice) => {\n  const grupo = (porPublicacao[entrada.publicacao_id] = porPublicacao[entrada.publicacao_id] || {\n    publicacao_id: entrada.publicacao_id,\n    total: entrada.total,\n    legenda: entrada.legenda,\n    filhos: [],\n  });\n  const resposta = criados[indice];\n  if (resposta && resposta.id) grupo.filhos.push({ ordem: entrada.ordem, id: resposta.id });\n});\n\nreturn Object.values(porPublicacao).map((g) => {\n  const completo = g.filhos.length === g.total;\n  return {\n    json: completo\n      ? {\n          falha: false,\n          publicacao_id: g.publicacao_id,\n          legenda: g.legenda,\n          children: g.filhos.sort((a, b) => a.ordem - b.ordem).map((f) => f.id).join(','),\n        }\n      : {\n          falha: true,\n          publicacao_id: g.publicacao_id,\n          erro: 'Só ' + g.filhos.length + ' de ' + g.total + ' imagens foram aceitas pelo Instagram.',\n        },\n  };\n});"
      },
      "id": "pub-agrupar",
      "name": "Agrupar filhos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "id": "completo",
              "leftValue": "={{ $json.falha }}",
              "rightValue": false,
              "operator": { "type": "boolean", "operation": "false", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "pub-se-completo",
